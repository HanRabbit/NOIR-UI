{
  "name": "noir-ui",
  "version": "0.2.0",
  "description": "NOIR UI — monochrome, minimal, fluid React components with motion-blur feedback",
  "keywords": [
    "react",
    "ui",
    "components",
    "monochrome",
    "motion",
    "animation",
    "motion-blur",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HanRabbit/NOIR-UI.git"
  },
  "homepage": "https://github.com/HanRabbit/NOIR-UI#readme",
  "type": "module",
  "main": "./dist/noir-ui.js",
  "module": "./dist/noir-ui.js",
  "exports": {
    ".": "./dist/noir-ui.js",
    "./styles.css": "./dist/noir-ui.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/index.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.js",
    "build:docs": "vite build",
    "preview": "vite preview",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0"
  }
}
